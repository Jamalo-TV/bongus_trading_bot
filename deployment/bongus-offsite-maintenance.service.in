[Unit]
Description=Bongus bounded encrypted-offsite retention maintenance
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/bongus/offsite-maintenance.env

[Service]
Type=oneshot
Slice=@SERVICE_NAME@.slice
User=@MAINTENANCE_USER@
Group=@MAINTENANCE_GROUP@
SupplementaryGroups=@SERVICE_GROUP@ @BACKUP_GROUP@
WorkingDirectory=@RELEASE_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BONGUS_DATA_ROOT=@DATA_ROOT@
Environment=TZ=UTC
EnvironmentFile=/etc/bongus/offsite-maintenance.env
ExecStart=/usr/bin/flock --exclusive --timeout 30 @DATA_ROOT@/offsite/locks/restic.lock @RELEASE_ROOT@/.venv/bin/python @RELEASE_ROOT@/scripts/maintain_offsite_repository.py --receipt-path @DATA_ROOT@/offsite/maintenance/latest.json --timeout-seconds 240
TimeoutStartSec=5min
UMask=0027
MemoryAccounting=true
MemoryMax=512000000
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=@DATA_ROOT@:ro
BindPaths=@DATA_ROOT@/offsite
