[Unit]
Description=Bongus encrypted offsite backup upload
Wants=network-online.target
After=network-online.target @SERVICE_NAME@-backup.service
ConditionPathExists=/etc/bongus/offsite-backup.env
ConditionPathIsDirectory=@DATA_ROOT@/backups

[Service]
Type=oneshot
Slice=@SERVICE_NAME@.slice
User=@OFFSITE_USER@
Group=@OFFSITE_GROUP@
SupplementaryGroups=@SERVICE_GROUP@ @BACKUP_GROUP@
WorkingDirectory=@RELEASE_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BONGUS_DATA_ROOT=@DATA_ROOT@
Environment=TZ=UTC
EnvironmentFile=/etc/bongus/offsite-backup.env
ExecStart=/usr/bin/flock --exclusive --timeout 300 @DATA_ROOT@/offsite/locks/restic.lock /usr/bin/flock --exclusive --timeout 300 @DATA_ROOT@/backups/.pipeline.lock @RELEASE_ROOT@/.venv/bin/python @RELEASE_ROOT@/scripts/upload_verified_offsite_backup.py --data-root @DATA_ROOT@ --backup-directory @DATA_ROOT@/backups --receipt-path @DATA_ROOT@/offsite/upload/latest.json
TimeoutStartSec=15min
UMask=0077
MemoryAccounting=true
MemoryMax=512000000
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=@DATA_ROOT@:ro
BindReadOnlyPaths=@DATA_ROOT@/backups
BindPaths=@DATA_ROOT@/offsite
