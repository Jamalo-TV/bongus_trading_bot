[Unit]
Description=Bongus verified operational SQLite backup
After=@SERVICE_NAME@.service
OnSuccess=@SERVICE_NAME@-offsite-backup.service
ConditionPathIsRegular=@DATA_ROOT@/state.db
ConditionPathIsRegular=@DATA_ROOT@/audit.db
ConditionPathIsRegular=@DATA_ROOT@/research.db
ConditionPathIsRegular=@DATA_ROOT@/live_config.json
ConditionPathExists=@DATA_ROOT@/runtime/rust/recovery-control.sock
ConditionFileIsExecutable=@RELEASE_ROOT@/bin/execution_engine

[Service]
Type=oneshot
Slice=@SERVICE_NAME@.slice
User=@BACKUP_USER@
Group=@BACKUP_GROUP@
SupplementaryGroups=@SERVICE_GROUP@
WorkingDirectory=@RELEASE_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BONGUS_DATA_ROOT=@DATA_ROOT@
Environment=TZ=UTC
ExecStart=/usr/bin/flock --exclusive --timeout 840 @DATA_ROOT@/backups/.pipeline.lock @RELEASE_ROOT@/.venv/bin/python @RELEASE_ROOT@/scripts/create_verified_backup_set.py create --data-root @DATA_ROOT@ --backup-directory @DATA_ROOT@/backups --rust-execution-binary @RELEASE_ROOT@/bin/execution_engine --rust-recovery-control-socket @DATA_ROOT@/runtime/rust/recovery-control.sock --rust-recovery-generations-directory @DATA_ROOT@/runtime/rust/recovery_generations --rust-recovery-timeout-ms 15000 --source-budget-bytes 8000000000 --set-budget-bytes 8000000000 --required-headroom-bytes 20000000000 --backup-tree-budget-bytes 20500000000 --retention-count 1
TimeoutStartSec=30min
UMask=0027
MemoryAccounting=true
MemoryMax=512000000
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=@DATA_ROOT@
ReadWritePaths=@DATA_ROOT@/backups
